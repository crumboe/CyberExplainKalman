    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| output: asis\n",
        "import numpy as np\n",
        "from scipy.stats import norm\n",
        "\n",
        "def generate_gaussian_svg(mu_px, sigma_px, data_id=\"bellcurve\", \n",
        "                         svg_width=1500, svg_height=880,\n",
        "                         color=\"#4296ff\", fill_opacity=0.3):\n",
        "    \"\"\"\n",
        "    Generate SVG element for a Gaussian/normal distribution curve.\n",
        "    WITHOUT section wrapper for embedding in slides.\n",
        "    \"\"\"\n",
        "    \n",
        "    # Define x range\n",
        "    x_min = 0\n",
        "    x_max = svg_width\n",
        "    baseline = svg_height - 50\n",
        "    \n",
        "    # FIXED number of points for consistent structure\n",
        "    num_points = 100\n",
        "    x_values = np.linspace(x_min, x_max, num_points)\n",
        "    \n",
        "    # Calculate y values using Gaussian formula\n",
        "    peak_height = (40/sigma_px) * svg_height\n",
        "    \n",
        "    y_values = []\n",
        "    for x in x_values:\n",
        "        exponent = -((x - mu_px) ** 2) / (2 * sigma_px ** 2)\n",
        "        y = np.exp(exponent)\n",
        "        y_pixel = baseline - (y * peak_height)\n",
        "        y_values.append(y_pixel)\n",
        "    \n",
        "    # Create points string for polyline\n",
        "    points = \" \".join([f\"{x:.2f},{y:.2f}\" for x, y in zip(x_values, y_values)])\n",
        "    \n",
        "    # Create points for filled polygon (add baseline corners)\n",
        "    fill_points = points + f\" {x_values[-1]:.2f},{baseline} {x_values[0]:.2f},{baseline}\"\n",
        "    \n",
        "    # Generate SVG with RGB color conversion\n",
        "    rgb = tuple(int(color.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))\n",
        "    fill_color = f\"rgba({rgb[0]}, {rgb[1]}, {rgb[2]}, {fill_opacity})\"\n",
        "    \n",
        "    # Return ONLY the SVG element, no section wrapper\n",
        "    svg = f'''<svg data-id=\"{data_id}\" style=\"position: absolute; left: 100px; top: 100px; width: {svg_width}px; height: {svg_height}px;\">\n",
        "  <polygon points=\"{fill_points}\" \n",
        "           fill=\"{fill_color}\" \n",
        "           stroke=\"{color}\" \n",
        "           stroke-width=\"4\"\n",
        "           stroke-linejoin=\"round\"/>\n",
        "</svg>'''\n",
        "    \n",
        "    return svg\n",
        "\n",
        "_generate_gaussian_svg = generate_gaussian_svg"
      ],
      "id": "29d89195",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| output: false\n",
        "\n",
        "# Generate all SVG strings upfront\n",
        "svg1_slide1 = _generate_gaussian_svg(mu_px=650, sigma_px=150, svg_height=830, data_id=\"bellcurveog1\", color=\"#55a709ff\",fill_opacity=0.1)\n",
        "svg2_slide1 = _generate_gaussian_svg(mu_px=1000, sigma_px=50, svg_height=830, svg_width=1500, data_id=\"bellcurveog2\", color=\"#5178f8ff\",fill_opacity=0.1)\n",
        "\n",
        "svg1_slide2 = _generate_gaussian_svg(mu_px=900, sigma_px=37, svg_height=830, data_id=\"bellcurve\", color=\"#55a709ff\")\n",
        "svg2_slide2 = _generate_gaussian_svg(mu_px=900, sigma_px=37, svg_height=830, svg_width=1500, data_id=\"bellcurve2\", color=\"#5178f8ff\")"
      ],
      "id": "1fcfcf67",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| output: false\n",
        "\n",
        "def generate_morph_slides(start_params, end_params, num_steps=10):\n",
        "    \"\"\"\n",
        "    Generate intermediate slides for smooth morphing animation.\n",
        "    \n",
        "    start_params: dict with 'mu_px' and 'sigma_px' for starting positions\n",
        "    end_params: dict with 'mu_px' and 'sigma_px' for ending positions\n",
        "    num_steps: number of intermediate frames\n",
        "    \"\"\"\n",
        "    slides = []\n",
        "    \n",
        "    for i in range(num_steps + 1):\n",
        "        # Linear interpolation factor (0 to 1)\n",
        "        t = i / num_steps\n",
        "        \n",
        "        # Interpolate parameters for both curves\n",
        "        mu1 = start_params['curve1']['mu_px'] + t * (end_params['curve1']['mu_px'] - start_params['curve1']['mu_px'])\n",
        "        sigma1 = start_params['curve1']['sigma_px'] + t * (end_params['curve1']['sigma_px'] - start_params['curve1']['sigma_px'])\n",
        "        \n",
        "        mu2 = start_params['curve2']['mu_px'] + t * (end_params['curve2']['mu_px'] - start_params['curve2']['mu_px'])\n",
        "        sigma2 = start_params['curve2']['sigma_px'] + t * (end_params['curve2']['sigma_px'] - start_params['curve2']['sigma_px'])\n",
        "        \n",
        "        # Generate SVGs for this frame\n",
        "        svg1 = _generate_gaussian_svg(mu_px=mu1, sigma_px=sigma1, svg_height=830, \n",
        "                                      data_id=\"bellcurve3\", color=\"#55a709ff\")\n",
        "        svg2 = _generate_gaussian_svg(mu_px=mu2, sigma_px=sigma2, svg_height=830, \n",
        "                                      svg_width=1500, data_id=\"bellcurve4\", color=\"#5178f8ff\")\n",
        "        \n",
        "        slides.append((svg1, svg2))\n",
        "    \n",
        "    return slides\n",
        "\n",
        "# Define start and end states\n",
        "start_state = {\n",
        "    'curve1': {'mu_px': 650, 'sigma_px': 150},\n",
        "    'curve2': {'mu_px': 1000, 'sigma_px': 50}\n",
        "}\n",
        "\n",
        "end_state = {\n",
        "    'curve1': {'mu_px': 900, 'sigma_px': 37},\n",
        "    'curve2': {'mu_px': 900, 'sigma_px': 37}\n",
        "}\n",
        "\n",
        "# Generate 15 intermediate frames for smooth animation\n",
        "morph_slides = generate_morph_slides(start_state, end_state, num_steps=15)"
      ],
      "id": "c7cadb37",
      "execution_count": null,
      "outputs": []
    },
